# 🌐 lead.ittc.edu.bd (Namecheap shared hosting, Apache)
# Every address that is not a real file opens the app (it finds the page itself)
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
  # A missing code / image / font file is "not found", never the app's page:
  # an old open tab then gets a clear error and loads the new version
  # (before, it got index.html as code: "Requiring unknown module")
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_URI} ^/_expo/ [OR]
  RewriteCond %{REQUEST_URI} \.(js|mjs|css|map|json|wasm|png|jpe?g|svg|gif|webp|ico|ttf|woff2?|tflite)$ [NC]
  RewriteRule ^ - [R=404,L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule ^ index.html [L]
</IfModule>

# The app's code files have a new name on every change: keep them long
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|png|jpg|svg|ttf|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

# 🖼 Photo Studio's face finder (MediaPipe): the right type for WebAssembly
<IfModule mod_mime.c>
  AddType application/wasm .wasm
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.(wasm|tflite)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
</IfModule>
