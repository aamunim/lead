{
  "expo": {
    "name": "Lead Management",
    "slug": "lead-management",
    "version": "2.5.4-beta",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "leadmanagement",
    "userInterfaceStyle": "automatic",
    "owner": "ittc.lead",
    "runtimeVersion": "1",
    "updates": {
      "url": "https://u.expo.dev/e1dd018b-e4a5-496c-adc3-0c4acb50f8f6",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "package": "com.abamunim.leads",
      "versionCode": 19,
      "adaptiveIcon": {
        "backgroundColor": "#3F5BD3",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#208AEF",
          "defaultChannel": "leads"
        }
      ],
      "expo-sharing",
      "@react-native-community/datetimepicker",
      [
        "expo-contacts",
        {
          "contactsPermission": "Lead Management reads your contacts only when you open Phone contacts, so you can choose people to save as leads. Only the contacts you mark are saved."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": false,
            "enableShrinkResourcesInReleaseBuilds": false
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "e1dd018b-e4a5-496c-adc3-0c4acb50f8f6"
      }
    }
  }
}
