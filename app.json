{
  "expo": {
    "name": "ITTC Admission",
    "slug": "lead-management",
    "version": "2.8.7",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "leadmanagement",
    "userInterfaceStyle": "automatic",
    "owner": "ittc.lead",
    "runtimeVersion": "3",
    "updates": {
      "url": "https://u.expo.dev/e1dd018b-e4a5-496c-adc3-0c4acb50f8f6",
      "checkAutomatically": "ON_LOAD",
      "fallbackToCacheTimeout": 0
    },
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "blockedPermissions": ["android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"],
      "package": "com.abamunim.leads",
      "versionCode": 29,
      "adaptiveIcon": {
        "backgroundColor": "#3F5BD3",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "name": "ITTC Admission Management System",
      "shortName": "ITTC Admission",
      "lang": "en",
      "favicon": "./assets/web/ittc-logo-64.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#208AEF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#208AEF",
          "defaultChannel": "leads"
        }
      ],
      "expo-sharing",
      [
        "expo-audio",
        {
          "microphonePermission": "ITTC Admission uses the microphone only while you record a voice note.",
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-image-picker",
        {
          "cameraPermission": "ITTC Admission uses the camera only when you take a photo of a paper.",
          "photosPermission": "ITTC Admission opens your photos only when you choose one to upload."
        }
      ],
      "@react-native-community/datetimepicker",
      [
        "expo-contacts",
        {
          "contactsPermission": "ITTC Admission reads your contacts only when you open Phone contacts, so you can choose people to save as leads. Only the contacts you mark are saved."
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableMinifyInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": false,
            "extraProguardRules": "-keep class expo.modules.calllog.** { *; }\n-keep class expo.modules.smscode.** { *; }\n-keepattributes SourceFile,LineNumberTable"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "eas": {
        "projectId": "e1dd018b-e4a5-496c-adc3-0c4acb50f8f6"
      }
    }
  }
}
